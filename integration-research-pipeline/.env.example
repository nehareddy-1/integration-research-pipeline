# Copy this file to .env and fill in your own keys. Never commit .env.
LLM_PROVIDER=openai        # openai (default) or gemini
OPENAI_API_KEY=            # platform.openai.com -> API keys (uses your credits)
COMPOSIO_API_KEY=          # Composio dashboard -> your project -> Settings -> API Keys
COMPOSIO_USER_ID=default   # the user id your Tavily + Firecrawl connections were created under

# Optional overrides
# RESEARCH_MODEL=gpt-5.4-mini
# VERIFY_MODEL=gpt-5.4
# OPENAI_REASONING_EFFORT=low   # low | medium | high (lower = cheaper and faster)
# LLM_RPM=200                   # lower this if you hit 429 rate limits
# PARALLEL_APPS=10              # apps researched at the same time (6 if Firecrawl refuses many page reads)
# SEARCH_TOOL=TAVILY_SEARCH
# SCRAPE_TOOL=FIRECRAWL_SCRAPE
# MAX_PAGES_PER_APP=4
# PIPELINE_MOCK=1               # offline test run with fake data
# GEMINI_API_KEY=               # only if LLM_PROVIDER=gemini

# Only used once by: python -m pipeline.connect_tools
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
